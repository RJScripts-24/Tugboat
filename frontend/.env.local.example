# Control Tower — local environment
#
# Copy to `.env.local` (git-ignored) and adjust if the API is not on :4000.

# Where the NestJS API lives.
#
# Deliberately NOT prefixed `NEXT_PUBLIC_`. Only server components and route
# handlers call the API (see `src/lib/api.ts`): the session is an httpOnly
# cookie the browser cannot read, so a browser-side call could not authenticate
# anyway, and a public base URL would invite one to be written.
API_URL=http://localhost:4000

# Where the browser reaches the Socket.IO gateway.
#
# Public, unlike API_URL, and it has to be: the socket is dialled by the browser
# itself. It carries no authority - the httpOnly session cookie does, and the
# gateway verifies it on the handshake exactly as the REST guard does - which is
# what makes publishing this harmless.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Deployed (Vercel in front of Render): set both to the API's public URL, e.g.
# API_URL=https://tugboat-api.onrender.com
# NEXT_PUBLIC_API_URL=https://tugboat-api.onrender.com
# The socket authenticates across the two sites with a short-lived token from
# /api/auth/socket-token (D-137); no other variable is needed.
