# TUGBOAT API — environment
#
# Copy to `.env` and fill in. Every variable below is validated by Zod at boot
# (src/config/env.validation.ts); the process refuses to start on a bad value
# rather than failing later inside a request.
#
# Stage 0 needs only the block marked REQUIRED. Third-party keys are requested
# stage by stage and are all optional until then — with LLM_MODE=fake and every
# channel simulated, the full agent loop runs offline at zero cost.

# ── REQUIRED ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# The application's connection. On Neon use the POOLED endpoint (host contains
# "-pooler"); with local Docker, the compose default below is correct.
DATABASE_URL=postgresql://tugboat:tugboat@localhost:5432/tugboat

# Optional. Prisma Migrate takes a session-level advisory lock that a connection
# pooler in transaction mode cannot hold, so migrations run against the direct
# endpoint - on Neon that is the same host without "-pooler". Omit it on a plain
# Postgres, where DATABASE_URL is already direct.
DIRECT_URL=

# Optional, and the choice it drives is load-bearing. Set, the agent schedules
# through BullMQ over Redis; unset, it uses the deterministic in-memory queue
# that runs jobs only when drained - which is what the test suite and the
# Stage 8 batch want, since a 200-case run cannot wait three real days for a
# mandate re-presentation.
#
# MUST be a Redis TCP URL - an HTTP endpoint such as Upstash's REST API cannot
# run a queue. In the Upstash console this is the "ioredis" / TCP string; it
# starts with rediss:// and ends in :6379.
REDIS_URL=redis://localhost:6379

# Minimum 32 characters. Generate one: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-32-character-minimum-secret

# The Control Tower's origin. Pinned rather than wildcarded because the session
# cookie travels with credentials.
FRONTEND_ORIGIN=http://localhost:3000

# ── EXECUTION MODES ─────────────────────────────────────────────────────────
# fake = deterministic offline driver (default, and what the batch runs on)
# live = Gemini/Groq over the network
LLM_MODE=fake

# simulated = offline adapter that records what it would have sent
# real       = the third-party service, using the keys below
CHANNEL_MODE_EMAIL=simulated
CHANNEL_MODE_WHATSAPP=simulated
CHANNEL_MODE_VOICE=simulated
CHANNEL_MODE_RAZORPAY=simulated

# ── WEBHOOKS ────────────────────────────────────────────────────────────────
# Required for POST /webhooks/razorpay to accept anything. Without it the route
# returns 503 and processes nothing - it will not accept unverified deliveries.
# Set this to the secret entered when creating the webhook in the Razorpay
# dashboard (Settings > Webhooks), not to an API key.
RAZORPAY_WEBHOOK_SECRET=

# ── LLM PROVIDERS (only read when LLM_MODE=live) ────────────────────────────
# With LLM_MODE=fake the whole agent loop runs offline and no key is needed.
# With LLM_MODE=live at least one of these must be set, or the app refuses to
# start - a run that believes it used a real model but did not would put false
# numbers in the evidence report.
#
# Routing: diagnosis and dialogue go to Gemini, everything else to Groq. If only
# one key is present it serves both lanes.
# GEMINI_API_KEY=        # aistudio.google.com - free daily quota
# GROQ_API_KEY=          # console.groq.com - free tier

# Model ids are config because providers deprecate them on their own schedule.
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# ── OPTIONAL: added in later stages ─────────────────────────────────────────

# Stage 10 — Razorpay TEST MODE only (dashboard.razorpay.com → API keys)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Stage 10 — email (resend.com free tier, 100/day)
# RESEND_API_KEY=
# RESEND_FROM=

# Stage 10 — WhatsApp (Twilio sandbox; optional, simulated adapter is the default)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=

# Stage 10 — Hinglish TTS (optional; edge-tts fallback needs no key)
# SARVAM_API_KEY=

# Stage 10 — webhook tunnel for local development
# NGROK_DOMAIN=
