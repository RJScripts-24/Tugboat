# TUGBOAT API — environment
#
# Copy to `.env` and fill in. Every variable below is validated by Zod at boot
# (src/config/env.validation.ts); the process refuses to start on a bad value
# rather than failing later inside a request.
#
# Stage 0 needs only the block marked REQUIRED. Third-party keys are requested
# stage by stage and are all optional until then — with LLM_MODE=fake and every
# channel simulated, the full agent loop runs offline at zero cost.

# ── REQUIRED ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# The application's connection. On Neon use the POOLED endpoint (host contains
# "-pooler"); with local Docker, the compose default below is correct.
DATABASE_URL=postgresql://tugboat:tugboat@localhost:5432/tugboat

# Optional. Prisma Migrate takes a session-level advisory lock that a connection
# pooler in transaction mode cannot hold, so migrations run against the direct
# endpoint - on Neon that is the same host without "-pooler". Omit it on a plain
# Postgres, where DATABASE_URL is already direct.
DIRECT_URL=

# Optional, and the choice it drives is load-bearing. Set, the agent schedules
# through BullMQ over Redis; unset, it uses the deterministic in-memory queue
# that runs jobs only when drained - which is what the test suite and the
# Stage 8 batch want, since a 200-case run cannot wait three real days for a
# mandate re-presentation.
#
# MUST be a Redis TCP URL - an HTTP endpoint such as Upstash's REST API cannot
# run a queue. In the Upstash console this is the "ioredis" / TCP string; it
# starts with rediss:// and ends in :6379.
REDIS_URL=redis://localhost:6379

# Minimum 32 characters. Generate one: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-32-character-minimum-secret

# The Control Tower's origin. Pinned rather than wildcarded because the session
# cookie travels with credentials.
FRONTEND_ORIGIN=http://localhost:3000

# ── EXECUTION MODES ─────────────────────────────────────────────────────────
# fake = deterministic offline driver (default, and what the batch runs on)
# live = Gemini/Groq over the network
LLM_MODE=fake

# simulated = offline adapter that records what it would have sent
# real       = the third-party service, using the keys below
CHANNEL_MODE_EMAIL=simulated
CHANNEL_MODE_WHATSAPP=simulated
CHANNEL_MODE_VOICE=simulated
CHANNEL_MODE_RAZORPAY=simulated

# ── WEBHOOKS ────────────────────────────────────────────────────────────────
# Required for POST /webhooks/razorpay to accept anything. Without it the route
# returns 503 and processes nothing - it will not accept unverified deliveries.
# Set this to the secret entered when creating the webhook in the Razorpay
# dashboard (Settings > Webhooks), not to an API key.
RAZORPAY_WEBHOOK_SECRET=

# ── LLM PROVIDERS (only read when LLM_MODE=live) ────────────────────────────
# With LLM_MODE=fake the whole agent loop runs offline and no key is needed.
# With LLM_MODE=live at least one of these must be set, or the app refuses to
# start - a run that believes it used a real model but did not would put false
# numbers in the evidence report.
#
# Routing: diagnosis and dialogue go to Gemini, everything else to Groq. If only
# one key is present it serves both lanes.
# GEMINI_API_KEY=        # aistudio.google.com - free daily quota
# GROQ_API_KEY=          # console.groq.com - free tier

# Model ids are config because providers deprecate them on their own schedule.
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=openai/gpt-oss-120b

# ── STAGE 10: REAL PROVIDERS ────────────────────────────────────────────────
# Each lane flips independently with CHANNEL_MODE_* above. A lane set to `real`
# without the key it needs REFUSES TO BOOT — an adapter that silently fell back
# to simulated would print "real message" beside messages nobody sent.
# Everything here is optional; the whole agent loop runs with none of it.

# Razorpay — TEST MODE ONLY (dashboard.razorpay.com → Settings → API keys).
# A live key (rzp_live_…) is refused at boot. With CHANNEL_MODE_RAZORPAY=real
# the "silent retry" issues one payment link per case (D-123) and the money
# comes back through the webhook below as payment_link.paid / payment.captured.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=

# Email through Resend (resend.com, free 100/day). With no verified domain the
# onboarding sender below delivers only to the address that owns the API key —
# which is exactly the acceptance test: one real payment-link email in the
# owner's inbox.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Boa at Tugboat <onboarding@resend.dev>

# WhatsApp through the Twilio sandbox (twilio.com console → Messaging → Try it
# out → WhatsApp). A recipient must first send "join <sandbox word>" to the
# sandbox number; nobody who has not joined can be reached, by construction.
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Voice. Telephony is simulated and labelled in every configuration (PRD 7.8;
# CHANNEL_MODE_VOICE=real is refused). What VOICE_TTS switches on is the
# recording: each turn of the transcript is synthesised and stitched into one
# file the Case Detail player streams from GET /media/voice/<call>.mp3.
#   off    = no recording; the browser reads the transcript aloud (default)
#   edge   = Microsoft Edge neural voices, free, no key (npm: msedge-tts)
#   sarvam = Sarvam Bulbul (sarvam.ai), Indic-first, needs SARVAM_API_KEY
VOICE_TTS=off
# SARVAM_API_KEY=
# Where recordings are written, relative to backend/. Git-ignored.
VOICE_AUDIO_DIR=var/voice

# Where the browser (and Razorpay) reach this API. Behind a tunnel this is the
# tunnel: e.g. https://<your-domain>.ngrok-free.app. Used for recording URLs
# and printed by the demo script as the webhook URL to register.
PUBLIC_API_URL=http://localhost:4000

# LLM keys live: set LLM_MODE=live above and one or both of GEMINI_API_KEY /
# GROQ_API_KEY (see the LLM PROVIDERS block). The fake driver remains the
# default and what every test and every batch runs on.

# ── WEBHOOK TUNNEL (development only) ───────────────────────────────────────
# Razorpay must reach POST /webhooks/razorpay on this machine. With a free
# static ngrok domain: `ngrok http --domain=<NGROK_DOMAIN> 4000`, then register
# https://<NGROK_DOMAIN>/webhooks/razorpay in the Razorpay dashboard with the
# same secret as RAZORPAY_WEBHOOK_SECRET and the events payment.failed,
# payment.captured, payment_link.paid, subscription.*, invoice.expired,
# payment_link.expired. The variable is documentation for the demo script; the
# API never reads it.
# NGROK_DOMAIN=
