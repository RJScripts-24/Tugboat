// TUGBOAT — data model
//
// Enum members deliberately mirror the wire vocabulary character for character
// (docs/TUGBOAT-BACKEND-BUILD-PROMPT.md §3.2), so the database, the API and the
// Control Tower share one spelling and no mapping layer can drift.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved connection URLs out of the schema. The CLI reads its URL from
// prisma.config.ts (the direct endpoint, since Migrate needs session-level
// advisory locks the Neon pooler cannot hold); the runtime client is handed the
// pooled URL explicitly in PrismaService.
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Vocabularies
// ─────────────────────────────────────────────────────────────────────────────

enum CaseType {
  PAYMENT_FAILED
  CHECKOUT_ABANDONED
  MANDATE_FAILED
  INVOICE_OVERDUE
}

enum RootCause {
  BANK_GATEWAY_DEGRADED
  INSUFFICIENT_FUNDS
  CUSTOMER_DISTRACTED
  CARD_EXPIRED
  MANDATE_REVOKED
  UNKNOWN
}

/// Lower-cased because the UI puts these straight into URLs (/cases?stage=recovered).
enum CaseStage {
  detected
  diagnosed
  intervening
  waiting
  escalated
  promised
  recovered
  halted
  exhausted
}

enum DiagnosisMethod {
  RULES
  LLM
}

enum Channel {
  RETRY
  WHATSAPP
  EMAIL
  VOICE
}

enum EventKind {
  DETECTED
  DIAGNOSED
  PLANNED
  POLICY_CHECK
  EMAIL_SENT
  WHATSAPP_SENT
  VOICE_CALL
  RETRY_EXECUTED
  CUSTOMER_REPLY
  PROMISE_RECORDED
  ESCALATED
  APPROVAL_DECIDED
  HALTED
  RECOVERED
}

enum ActionKind {
  EMAIL
  WHATSAPP
  VOICE
  RETRY
  PAYMENT_LINK
  ESCALATE
}

enum ActionStatus {
  PLANNED
  BLOCKED
  NEEDS_APPROVAL
  EXECUTED
  FAILED
}

enum PolicyVerdict {
  ALLOWED
  BLOCKED
  NEEDS_APPROVAL
}

enum ApprovalGate {
  discount_requires_approval
  b2b_high_value
  confidence_below_threshold
  hardship_language
}

enum ApprovalDecision {
  approved
  rejected
}

enum PromiseStatus {
  PENDING
  KEPT
  BROKEN
}

enum LedgerActor {
  BOA
  POLICY
  HUMAN
  SYSTEM
}

/// The wire value is "opt-out"; a hyphen is not a legal Prisma identifier, so
/// the boundary maps opt_out <-> "opt-out" (see src/common/vocabulary.ts).
enum Sentiment {
  positive
  neutral
  negative
  opt_out
}

enum CustomerSegment {
  B2C
  B2B
}

enum SimArm {
  baseline
  naive
  tugboat
}

enum SimRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────────────────────

/// One seeded row for the buildathon. merchantId is carried on every owned
/// record regardless, so multi-tenancy is a migration rather than a rewrite.
model Merchant {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  customers      Customer[]
  cases          Case[]
  policyVersions PolicyVersion[]
  simRuns        SimRun[]

  @@map("merchants")
}

model Customer {
  id         String  @id @default(cuid())
  merchantId String
  name       String
  email      String?
  phone      String?
  /// What any screen-share surface is allowed to show.
  maskedEmail String?
  maskedPhone String?
  languagePref String          @default("en-IN")
  segment      CustomerSegment @default(B2C)
  /// Set the instant an opt-out keyword is seen; blocks contact at the gate forever.
  optedOutAt   DateTime?
  /// Simulator persona. Agent modules must never read this (ADR-10) — only the
  /// simulator writes it and only metrics joins it, at grading time.
  personaJson  Json?
  createdAt    DateTime        @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  cases    Case[]

  @@index([merchantId])
  @@map("customers")
}

// ─────────────────────────────────────────────────────────────────────────────
// The case and its append-only history
// ─────────────────────────────────────────────────────────────────────────────

/// The integer id is internal; every boundary renders it as "C-<id>"
/// (src/common/case-ref.ts), which is the reference the Control Tower addresses.
model Case {
  id         Int    @id @default(autoincrement())
  merchantId String
  customerId String

  type        CaseType
  amountPaise Int
  currency    String    @default("INR")
  stage       CaseStage @default(detected)

  rootCause           RootCause?
  diagnosisConfidence Float?
  diagnosisMethod     DiagnosisMethod?
  /// Which rule fired, e.g. "R-03". Null when the model was asked instead.
  diagnosisRuleId     String?
  diagnosisAt         DateTime?

  /// The gateway's own account of the failure — the Diagnoser's raw input.
  failureCode   String?
  failureReason String?
  failureSource String?
  instrument    String?

  /// Set when this case was opened inside a detected gateway degradation, which
  /// is what lets the Planner prefer waiting over blaming the customer.
  degradationIncidentId String?

  /// The classifier's reading of the most recent inbound reply. Stored on the
  /// case rather than parsed back out of the timeline, because the PolicyGate
  /// reads it on every check and the score is what the threshold compares to.
  lastSentiment      Sentiment?
  lastSentimentScore Float?
  /// Set when a reply declared financial hardship or disputed the charge; the
  /// escalation gate refuses to act alone from that moment on.
  hardshipFlaggedAt  DateTime?

  /// The Razorpay object this case was opened from.
  originKind String?
  originId   String?
  originRef  String?

  deadlineAt           DateTime?
  attemptsUsed         Int       @default(0)
  attemptCap           Int       @default(4)
  recoveredAmountPaise Int       @default(0)
  costPaise            Int       @default(0)

  /// Set only on cases generated by a simulation run.
  simRunId String?
  simArm   SimArm?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant        Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  simRun          SimRun?              @relation(fields: [simRunId], references: [id], onDelete: SetNull)
  degradation     DegradationIncident? @relation(fields: [degradationIncidentId], references: [id], onDelete: SetNull)
  events          CaseEvent[]
  actions         Action[]
  policyDecisions PolicyDecision[]
  approvals       Approval[]
  promises        PaymentPromise[]
  llmCalls        LlmCall[]
  groundTruth     SimGroundTruth?

  @@index([merchantId, stage])
  @@index([merchantId, type])
  @@index([merchantId, rootCause])
  @@index([simRunId])
  @@map("cases")
}

/// Append-only. The Case Detail timeline renders these rows directly (ADR-2),
/// so there is one account of what happened rather than two that can disagree.
model CaseEvent {
  id         Int       @id @default(autoincrement())
  caseId     Int
  seq        Int
  kind       EventKind
  occurredAt DateTime  @default(now())

  title      String
  summary    String
  badgeLabel String?
  badgeTone  String?
  /// Shaped like the frontend's EventBody union.
  body       Json?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, seq])
  @@index([caseId, seq])
  @@map("case_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Outbound work
// ─────────────────────────────────────────────────────────────────────────────

model Action {
  id      String       @id @default(cuid())
  caseId  Int
  kind    ActionKind
  channel Channel?
  status  ActionStatus @default(PLANNED)
  attempt Int          @default(1)

  /// Checked before execution so a retried job cannot double-send (ADR-8).
  idempotencyKey String @unique

  scheduledFor DateTime?
  executedAt   DateTime?
  /// Provider-side id: Razorpay payment/link id, Twilio SID, Resend id.
  channelRef   String?
  costPaise    Int       @default(0)
  /// BullMQ job id, so a cancelled case can drop its scheduled work.
  jobId        String?
  failureReason String?
  payload      Json?
  createdAt    DateTime  @default(now())

  case           Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  policyDecision PolicyDecision?
  approval       Approval?

  @@index([caseId])
  @@index([status, scheduledFor])
  @@map("actions")
}

/// Every gate verdict, including the allows — "bounded" is only provable if the
/// passes are logged as carefully as the blocks (ADR-6).
model PolicyDecision {
  id       String        @id @default(cuid())
  caseId   Int
  actionId String?       @unique
  verdict  PolicyVerdict
  /// Shaped like the frontend's PolicyCheck[]: name, verdict, note.
  checks   Json
  policyVersionId String
  /// Set when a block deferred the action rather than killing it (quiet hours).
  rescheduledFor  DateTime?
  evaluatedAt     DateTime  @default(now())
  evaluatedInMs   Int       @default(0)

  case          Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  action        Action?       @relation(fields: [actionId], references: [id], onDelete: SetNull)
  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id])

  @@index([caseId])
  @@map("policy_decisions")
}

model Approval {
  id       String       @id @default(cuid())
  caseId   Int
  actionId String?      @unique
  gate     ApprovalGate

  headline        String
  /// string[] — the planner's two-line case for the ask.
  justification   Json
  chips           Json
  /// Shaped like the frontend's DraftMessage: the exact thing that would be sent.
  draft           Json
  candidates      Json?
  concessionPaise Int          @default(0)
  atRiskPaise     Int

  requestedAt    DateTime          @default(now())
  decision       ApprovalDecision?
  decidedBy      String?
  reason         String?
  decidedAt      DateTime?
  latencySeconds Int?

  case   Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  action Action? @relation(fields: [actionId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([decision])
  @@map("approvals")
}

/// Named PaymentPromise rather than Promise: a generated type called `Promise`
/// would shadow the global one in every file that imports it.
model PaymentPromise {
  id                  String        @id @default(cuid())
  caseId              Int
  promisedAmountPaise Int
  promisedDate        DateTime
  status              PromiseStatus @default(PENDING)
  followUpJobId       String?
  createdAt           DateTime      @default(now())
  resolvedAt          DateTime?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([status, promisedDate])
  @@map("promises")
}

// ─────────────────────────────────────────────────────────────────────────────
// Evidence
// ─────────────────────────────────────────────────────────────────────────────

/// Append-only and hash-chained (ADR-9). The app role holds INSERT and SELECT
/// only; see the grant statement in the migration notes.
model AuditLedger {
  id       String      @id @default(cuid())
  /// One chain per case ("C-1195"), plus "policy" for policy-pack edits.
  chain    String
  seq      Int
  hash     String
  prevHash String
  /// Everything the digest covers except prevHash, so a browser can recompute
  /// the chain itself instead of being told it is intact.
  seed     String
  actor    LedgerActor
  action   String
  at       DateTime    @default(now())
  detail   String
  caseId   Int?
  /// Dotted paths inside payload whose value was masked before storage.
  masked   String[]    @default([])
  payload  Json

  @@unique([chain, seq])
  @@index([chain, seq])
  @@index([caseId])
  @@index([actor])
  @@map("audit_ledger")
}

/// Policies are versioned data, not code (ADR-12): every policy decision points
/// at the exact version it was checked against.
model PolicyVersion {
  id         String   @id @default(cuid())
  merchantId String
  version    String
  /// Shaped like the frontend's PolicyPack.
  pack       Json
  /// Content hash of the pack. The revision *chain* hash is derived on read
  /// (PolicyService.revisions) so it stays compatible with the browser's
  /// recomputation; this one identifies the pack itself.
  hash       String
  note       String?
  /// One readable line per field that moved, e.g. "contact.maxAttempts 4 → 6".
  /// Rendered by the Policies page and covered by the revision chain.
  changes    String[] @default([])
  isActive   Boolean  @default(false)
  createdBy  String?
  createdAt  DateTime @default(now())

  merchant  Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  decisions PolicyDecision[]
  simRuns   SimRun[]

  @@unique([merchantId, version])
  @@index([merchantId, isActive])
  @@map("policy_versions")
}

model SimRun {
  id              String       @id @default(cuid())
  merchantId      String
  seed            Int
  batchSize       Int
  mix             Json
  difficulty      String
  arms            String[]
  policyVersionId String?
  status          SimRunStatus @default(QUEUED)
  progress        Int          @default(0)
  startedAt       DateTime?
  finishedAt      DateTime?
  /// The full evidence report JSON, saved so judges can read it without a rerun.
  report          Json?
  headline        Json?
  createdAt       DateTime     @default(now())

  merchant      Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  policyVersion PolicyVersion?   @relation(fields: [policyVersionId], references: [id], onDelete: SetNull)
  cases         Case[]
  groundTruth   SimGroundTruth[]

  @@index([merchantId, createdAt])
  @@map("sim_runs")
}

/// The answer key. Readable only by the metrics module, and only at grading
/// time — the agent has no import path to it (ADR-10).
model SimGroundTruth {
  id             String    @id @default(cuid())
  simRunId       String
  caseId         Int       @unique
  trueRootCause  RootCause
  personaSummary String
  personaJson    Json
  /// Whether the persona would ever have paid, which is what the baseline arm measures.
  wouldSelfRecover Boolean @default(false)

  simRun SimRun @relation(fields: [simRunId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([simRunId])
  @@map("sim_ground_truth")
}

/// Cost metering as a first-class concern (ADR-11): actual spend on free tiers,
/// plus what the same call would cost at production prices.
model LlmCall {
  id                 String   @id @default(cuid())
  caseId             Int?
  simRunId           String?
  provider           String
  model              String
  purpose            String
  tokensIn           Int      @default(0)
  tokensOut          Int      @default(0)
  costPaise          Int      @default(0)
  projectedCostPaise Int      @default(0)
  latencyMs          Int      @default(0)
  createdAt          DateTime @default(now())

  case Case? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([simRunId])
  @@map("llm_calls")
}

/// One row per observed payment outcome, success or failure.
///
/// The degradation detector (PRD 7.7) needs a denominator: a burst of failures
/// means nothing without knowing how many payments succeeded alongside them.
/// Persisted rather than held in memory so the rolling window survives a
/// restart and is inspectable after the fact.
model PaymentSample {
  id         Int      @id @default(autoincrement())
  merchantId String
  at         DateTime @default(now())
  /// Start of the 5-minute bucket this sample falls in, so grouping is an index scan.
  bucket     DateTime
  success    Boolean
  method     String?
  bank       String?
  simRunId   String?

  @@index([merchantId, bucket])
  @@index([merchantId, at])
  @@map("payment_samples")
}

/// A detected dip in gateway health, and the cases it explains.
model DegradationIncident {
  id          String    @id @default(cuid())
  merchantId  String
  detectedAt  DateTime  @default(now())
  recoveredAt DateTime?
  windowRate   Float
  baselineRate Float
  zScore       Float
  casesOpened  Int      @default(0)
  note         String?

  cases Case[]

  @@index([merchantId, detectedAt])
  @@map("degradation_incidents")
}

/// Webhook de-duplication (ADR-8). The unique constraint on eventId is the
/// whole mechanism: a repeat delivery loses the insert race and is a no-op.
model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  source      String
  eventType   String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  caseId      Int?

  @@index([source, eventType])
  @@map("webhook_events")
}
